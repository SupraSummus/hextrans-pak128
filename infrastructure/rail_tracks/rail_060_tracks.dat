#TRACK
obj=way
name=Rail_060_Tracks
copyright=Fabio Gonella
waytype=track
draw_as_ding=0
cost=3000
maintenance=75
topspeed=60
max_weight=120
intro_year=1810
intro_month=1
retire_year=1970
retire_month=1
icon=> rail_060_tracks.0.6
cursor=rail_060_tracks.0.7,0,-16
# Hex sprites — one per non-empty hex ribi (63 cells) — come from
# the bespoke-pipeline bake at rail_060_tracks/scene.py::
# bake_pakset() → rail_060_tracks_hex.png.  Atlas is an 8×8 grid
# (last slot empty), filled in HEX_ENTRIES order: 6 single-edge
# stubs, 15 edge pairs (straights + bends), 20 three-way, 15
# four-way, 6 five-way, and the all-six-edge sprite — popcount-
# then-ribi order, so cell index `i` lands at row `i//8`, col
# `i%8`.  3+ way cells are placeholder geometry: one stub per
# active edge meeting at the tile centre, no real switch
# frog/points.  Winter aliases the same cells until a hex winter
# palette lands.  The no-track Image[-] placeholder still borrows
# an upstream pak128 cell in both seasons (no hex model for the
# "no track laid" frame yet).
#
# Slope sprites (ImageUp[…]):  12 way-buildable hex slopes — 6
# narrow (2-corner) edge slopes + 6 wide (4-corner) variants.
# Each of the 6 axis directions has its own cell in
# rail_060_tracks_hex_slope.png (baked by SLOPE_HEX_ENTRIES); narrow
# and wide of the same direction share a cell because the rail
# climbs the same 0→1 path, only the off-axis ground inflection
# differs.  Winter aliases summer until a hex winter palette lands.
#SUMMER
Image[-][0]=rail_060_tracks.1.0
