## 40 KM/H STONE CITY ROAD
## Speed : 40
## Intro : 1
## Retire: 1950
## Road + Bridge + Elevated + Tunnel
#ROAD
obj=way
has_double_slopes=1
name=Road_040
waytype=road
copyright=Fabio Gonella
draw_as_ding=0
cost=8000
maintenance=220
topspeed=40
max_weight=50
intro_year=1
intro_month=1
retire_year=1950
retire_month=1
icon=> road_040.0.6
cursor=road_040.0.7,0,-16
# Hex sprites — one per non-empty hex ribi (63 cells) — come from
# the bespoke-pipeline bake at road_040/scene.py::bake_pakset() →
# road_040_hex.png.  Atlas is an 8×8 grid (last slot empty),
# filled in HEX_ENTRIES order: 6 single-edge stubs, 15 edge pairs
# (straights + bends), 20 three-way, 15 four-way, 6 five-way, and
# the all-six-edge sprite — popcount-then-ribi order, so cell
# index `i` lands at row `i//8`, col `i%8`.  3+ way cells are
# placeholder geometry: one stub per active edge meeting at the
# tile centre, no real intersection markings.  The no-road Image[-]
# placeholder still borrows an upstream pak128 square cell (no hex
# model for "no road laid").
#
# Slope sprites (ImageUp[…]):  18 way-buildable hex slopes — 6
# narrow (2-corner) edge slopes + 6 wide (4-corner) variants +
# 6 double-height (012210) variants.  Single-height narrow and
# wide of the same direction share atlas row 0 (the pavement
# climbs the same 0→1 path; only the off-axis ground inflection
# differs); double-height variants live in atlas row 1, baked
# with `lay_axis_slope(steps=2)` so the chord climbs 0→2 to
# match `slope_t::*_double`.
#
# Single-season: no winter art yet.  The engine treats a way
# without Image[-][1] as year-round summer; see way_writer.cc.
Image[-][0]=road_040.1.0
Image[se][0]=road_040_hex.0.0
Image[s][0]=road_040_hex.0.1
Image[sw][0]=road_040_hex.0.2
