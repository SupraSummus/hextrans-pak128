## 30 KM/H DIRT ROAD
## Speed : 30
## Intro : 1
## Retire: -
## Road + Bridge
#ROAD
obj=way
name=Road_030
waytype=road
copyright=Fabio Gonella
draw_as_ding=0
cost=1500
maintenance=130
topspeed=30
max_weight=40
intro_year=1
intro_month=1
icon=> road_030.0.6
cursor=road_030.0.7,0,-16
# Hex sprites — one per non-empty hex ribi (63 cells) — come
# from the bespoke-pipeline bake at
# infrastructure/roads/road_030/scene.py::bake_pakset() →
# road_030_hex.png.  Atlas is an 8×8 grid (last slot empty),
# filled in HEX_ENTRIES order: 6 single-edge stubs, 15 edge pairs
# (straights + bends), 20 three-way, 15 four-way, 6 five-way,
# and the all-six-edge sprite — popcount-then-ribi order.
# 3+ way cells are placeholder geometry: one stub per active
# edge meeting at the tile centre.  The no-road Image[-]
# placeholder still borrows an upstream pak128 square cell.
#
# Slope sprites (ImageUp[…]):  12 way-buildable hex slopes — 6
# narrow (2-corner) edge slopes + 6 wide (4-corner) variants.
# Each axis direction has a cell in road_030_hex_slope.png;
# narrow and wide of the same direction share a cell because
# the pavement climbs the same 0→1 path.
#
# Single-season: no winter art yet.  The engine treats a way
# without Image[-][1] as year-round summer; see way_writer.cc.
Image[-][0]=road_030.1.0
Image[se][0]=road_030_hex.0.0
Image[s][0]=road_030_hex.0.1
