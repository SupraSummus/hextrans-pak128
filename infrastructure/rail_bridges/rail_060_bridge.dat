#BRIDGE
# Hex bridge.  Every image is baked by `rail_060_bridge/scene.py` into
# `rail_060_bridge_hex.png`; the structure is `rail_bridge_params.py`.
# Atlas: 9 cells a row, filled row-major in the order of the
# keys below (`tools/threed/bridge.py::hex_entries`): Back/Front
# segment per way axis (n_s, ne_sw, nw_se), the three pillars, then
# Back/Front ramp, start and start2 per hex edge (n, s, ne, se, sw,
# nw); keys per engine `bridge_desc_t::img_t`.  Single season.  Icon
# and cursor stay on the pak128 sheet `rail_060_bridge.png`.
obj=bridge
name=Rail_060_Bridge
copyright=Fabio Gonella
waytype=track
cost=44000
maintenance=1100
topspeed=60
max_lenght=6
intro_year=1810
intro_month=1
retire_year=1940
retire_month=1
pillar_distance=1
pillar_asymmetric=1
icon=> rail_060_bridge.0.6
cursor=rail_060_bridge.0.7,0,-16
BackImage[n_s][0]=rail_060_bridge_hex.0.0
FrontImage[n_s][0]=rail_060_bridge_hex.0.1
BackImage[ne_sw][0]=rail_060_bridge_hex.0.2
FrontImage[ne_sw][0]=rail_060_bridge_hex.0.3
BackImage[nw_se][0]=rail_060_bridge_hex.0.4
FrontImage[nw_se][0]=rail_060_bridge_hex.0.5
backPillar[n_s][0]=rail_060_bridge_hex.0.6
backPillar[ne_sw][0]=rail_060_bridge_hex.0.7
backPillar[nw_se][0]=rail_060_bridge_hex.0.8
BackRamp[n][0]=rail_060_bridge_hex.1.0
FrontRamp[n][0]=rail_060_bridge_hex.1.1
BackRamp[s][0]=rail_060_bridge_hex.1.2
FrontRamp[s][0]=rail_060_bridge_hex.1.3
BackRamp[ne][0]=rail_060_bridge_hex.1.4
FrontRamp[ne][0]=rail_060_bridge_hex.1.5
BackRamp[se][0]=rail_060_bridge_hex.1.6
FrontRamp[se][0]=rail_060_bridge_hex.1.7
BackRamp[sw][0]=rail_060_bridge_hex.1.8
FrontRamp[sw][0]=rail_060_bridge_hex.2.0
BackRamp[nw][0]=rail_060_bridge_hex.2.1
FrontRamp[nw][0]=rail_060_bridge_hex.2.2
BackStart[n][0]=rail_060_bridge_hex.2.3
FrontStart[n][0]=rail_060_bridge_hex.2.4
BackStart[s][0]=rail_060_bridge_hex.2.5
FrontStart[s][0]=rail_060_bridge_hex.2.6
BackStart[ne][0]=rail_060_bridge_hex.2.7
FrontStart[ne][0]=rail_060_bridge_hex.2.8
BackStart[se][0]=rail_060_bridge_hex.3.0
FrontStart[se][0]=rail_060_bridge_hex.3.1
BackStart[sw][0]=rail_060_bridge_hex.3.2
FrontStart[sw][0]=rail_060_bridge_hex.3.3
BackStart[nw][0]=rail_060_bridge_hex.3.4
FrontStart[nw][0]=rail_060_bridge_hex.3.5
BackStart2[n][0]=rail_060_bridge_hex.3.6
FrontStart2[n][0]=rail_060_bridge_hex.3.7
BackStart2[s][0]=rail_060_bridge_hex.3.8
FrontStart2[s][0]=rail_060_bridge_hex.4.0
BackStart2[ne][0]=rail_060_bridge_hex.4.1
FrontStart2[ne][0]=rail_060_bridge_hex.4.2
BackStart2[se][0]=rail_060_bridge_hex.4.3
FrontStart2[se][0]=rail_060_bridge_hex.4.4
