way=Road_050
waytype=road
copyright=Fabio Gonella + hextrans
cost=110000
maintenance=1900
topspeed=50
intro_year=1930
intro_month=1
icon=> road_050_tunnel.1.0
cursor=road_050_tunnel.1.0,0,-16
#SUMMER
