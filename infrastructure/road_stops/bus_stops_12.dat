---------------------------------------------------------------------------------
# SMALL CLASSIC BUS STOP
#--------------------------------------------------------------------------------

Obj=building
Name=small_classic_bus_stop
type=stop
waytype=road
copyright=Fabio Gonella
enables_pax=1
enables_post=0
allow_underground=2
NoInfo=1
Dims=1,1,12
Level = 1
intro_year=1950
intro_month=1
icon=> bus_stops_ico.2.0
cursor=bus_stops_ico.2.1
# Layouts 4 * axis + ends: axes N-S, NW-SE, NE-SW; end bit 0
# at the S/SE/SW end, bit 1 at N/NW/NE.  Baked by
# hex_stops/scene.py.
