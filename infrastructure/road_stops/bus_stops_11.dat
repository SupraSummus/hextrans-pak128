---------------------------------------------------------------------------------
# SMALL EARLY BUS STOP
#--------------------------------------------------------------------------------

Obj=building
Name=small_early_bus_stop
type=stop
waytype=road
copyright=Fabio Gonella
enables_pax=1
enables_post=0
allow_underground=2
NoInfo=1
Dims=1,1,8
Level = 1
intro_year=1600
intro_month=1
retire_year=1950
retire_month=1
icon=> bus_stops_ico.1.0
cursor=bus_stops_ico.1.1
# Layouts 0, 1, 5: N-S, NW-SE, NE-SW road; the others repeat
# them.  Baked by hex_stops/scene.py.
