#TUNNEL
# Baked from `rail_320_tunnel/scene.py`: the 6x2 atlas rail_320_tunnel.png,
# 6 columns in `hex_keys::edge_names` order {n, s, ne, se, sw, nw},
# row 0 = FrontImage, row 1 = BackImage; key layout as in
# `rail_060_tunnel.dat`.  Single season.  The legacy art, with its
# winter cells in row 2, is in `rail_320_tunnel/src/`, no longer packaged.
obj=tunnel
name=Rail_320_Tunnel
copyright=Fabio Gonella + hextrans
waytype=track
way=Rail_320_Tracks
cost=200000
maintenance=2900
topspeed=320
intro_year=1980
intro_month=1
retire_year=2999
retire_month=1
icon=> rail_320_tunnel.1.0
cursor=rail_320_tunnel.1.0,0,-16
#SUMMER
FrontImage[n][0]=rail_320_tunnel.0.0
FrontImage[s][0]=rail_320_tunnel.0.1
FrontImage[ne][0]=rail_320_tunnel.0.2
FrontImage[se][0]=rail_320_tunnel.0.3
FrontImage[sw][0]=rail_320_tunnel.0.4
FrontImage[nw][0]=rail_320_tunnel.0.5
BackImage[n][0]=rail_320_tunnel.1.0
BackImage[s][0]=rail_320_tunnel.1.1
BackImage[ne][0]=rail_320_tunnel.1.2
BackImage[se][0]=rail_320_tunnel.1.3
BackImage[sw][0]=rail_320_tunnel.1.4
BackImage[nw][0]=rail_320_tunnel.1.5
