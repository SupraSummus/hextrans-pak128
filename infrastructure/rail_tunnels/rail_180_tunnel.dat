#TUNNEL
# Baked from `rail_180_tunnel/scene.py`: the 6x2 atlas rail_180_tunnel.png,
# 6 columns in `hex_keys::edge_names` order {n, s, ne, se, sw, nw},
# row 0 = FrontImage, row 1 = BackImage; key layout as in
# `rail_060_tunnel.dat`.  Single season.  The legacy art, with its
# winter cells in row 2, is in `rail_180_tunnel/src/`, no longer packaged.
obj=tunnel
name=Rail_180_Tunnel
copyright=Fabio Gonella + hextrans
waytype=track
way=Rail_180_Tracks
cost=130000
maintenance=1900
topspeed=180
intro_year=2000
intro_month=1
retire_year=2030
retire_month=1
icon=> rail_180_tunnel.1.0
cursor=rail_180_tunnel.1.0,0,-16
#SUMMER
FrontImage[n][0]=rail_180_tunnel.0.0
FrontImage[s][0]=rail_180_tunnel.0.1
FrontImage[ne][0]=rail_180_tunnel.0.2
FrontImage[se][0]=rail_180_tunnel.0.3
FrontImage[sw][0]=rail_180_tunnel.0.4
FrontImage[nw][0]=rail_180_tunnel.0.5
BackImage[n][0]=rail_180_tunnel.1.0
BackImage[s][0]=rail_180_tunnel.1.1
BackImage[ne][0]=rail_180_tunnel.1.2
BackImage[se][0]=rail_180_tunnel.1.3
BackImage[sw][0]=rail_180_tunnel.1.4
BackImage[nw][0]=rail_180_tunnel.1.5
