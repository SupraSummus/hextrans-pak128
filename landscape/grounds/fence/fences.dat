#
# Generated by landscape/grounds/fence/build_pakset.py.
# Do not edit by hand — regenerate after changing the canonical renderer.
#
# Fence sprites for the tile's three north-side edges (the engine's
# back-wall slots).  The engine puts a fence on an edge when the
# neighbour behind a level edge lies lower and the tile shows no cliff
# face; one whole-tile cell carries every fence of the tile.
# `calc_back_image` in the engine's `grund.cc` builds
#
#     mask = [NW edge] + 2 * [N edge] + 4 * [NE edge]      (1..7)
#
# and `display_boden` draws `Image[mask - 1]` for natural ground, or
# `Image[mask - 1 + 7]` for artificial ground (a building
# foundation or an artificial slope):
#
#   mask  edges     natural  artificial
#   1     NW        0        7
#   2     N         1        8
#   3     NW+N      2        9
#   4     NE        3        10
#   5     NW+NE     4        11
#   6     N+NE      5        12
#   7     NW+N+NE   6        13
#
# The cell is the flat tile; the engine lifts it by the higher of the
# NW and NE corner heights.  A fence stands on its edge line and is
# drawn before the tile's ground, so the cell keeps everything on or
# below the edge line empty and starts one pixel above it.
#
# Natural ground gets a one-pixel dark-olive line along the edge,
# artificial ground a low brown wooden fence (posts at 8 equal
# steps along each edge, two rails).  Colours, height and rail layout
# follow the legacy Fabio Gonella fences this descriptor replaces.
#
Obj=ground
Name=Fence

# atlas: 7 cols x 2 rows, cells named fences.<row>.<col>

Image[0][0]=fences.0.0	# natural NW
Image[1][0]=fences.0.1	# natural N
Image[2][0]=fences.0.2	# natural NW+N
Image[3][0]=fences.0.3	# natural NE
Image[4][0]=fences.0.4	# natural NW+NE
Image[5][0]=fences.0.5	# natural N+NE
Image[6][0]=fences.0.6	# natural NW+N+NE
Image[7][0]=fences.1.0	# artificial NW
Image[8][0]=fences.1.1	# artificial N
Image[9][0]=fences.1.2	# artificial NW+N
Image[10][0]=fences.1.3	# artificial NE
Image[11][0]=fences.1.4	# artificial NW+NE
Image[12][0]=fences.1.5	# artificial N+NE
Image[13][0]=fences.1.6	# artificial NW+N+NE
